// The assumptions register (DESIGN 8.8 and 21).
//
// Every value the wiki does not document, or contradicts itself about, lives
// here with an id. Code and data reference the id; neither writes the number
// (ENG-4). Every run reports which assumptions it relied on, so a result built
// on guesses says so.
//
// `value: Pending` is a real answer, not an absence: it says nobody has worked
// this out yet, which is different from, and more useful than, a placeholder
// zero. Anything citing a Pending assumption gets a warning saying the result
// is uncalibrated.
//
// NOTE ON STATUS: T1.6.2 asked for five values and Pending for the rest. Ten
// are given values here rather than five, because P1's research settled them
// and marking a settled value Pending would be the same lie in the other
// direction: core/modes.ron already uses A-005's +5, and core/ranges.ron
// already uses A-018's 3000 and A-024's 166. The ids that are genuinely
// unknown are Pending, and each says which task will settle it.
(
    provenance: (
        sources: [
            "https://wiki.guildwars.com/wiki/Guild_Wars_Wiki",
        ],
        crawled: "2026-09-22",
        review: Draft,
        reviewed_by: None,
        assumptions: [],
        notes: "The 33 initial entries from DESIGN 21. Statements and rationales are in our own words.",
    ),

    assumptions: [
        (
            id: "A-001",
            statement: "The base movement speed of characters and foes, in gwinches per second.",
            value: Gwinches(288.0),
            unit: Some(Gwinches),
            rationale: "The wiki's Movement and Speed boost pages describe speed only in relative terms. 288 gwinches per second is the community-documented base run speed (the agent speed that the game client reports), used here as a labelled community value, not a wiki fact.",
            status: Assumed,
            sources: ["https://wiki.guildwars.com/wiki/Movement", "https://wiki.guildwars.com/wiki/Speed_boost"],
            notes: "Set by T3.2.1. Modifiers multiply it, capped at +34% and -50% (ENG-33).",
        ),
        (
            id: "A-002",
            statement: "The collision radius of a unit, which decides body-blocking.",
            value: Gwinches(40.0),
            unit: Some(Gwinches),
            rationale: "Not documented anywhere. 40 keeps two units in contact (80 apart) well inside melee reach (touch, 144), which body-blocking needs: a blocker must stop a melee foe without stopping it from hitting the blocker.",
            status: Assumed,
            sources: ["https://wiki.guildwars.com/wiki/Body_block"],
            notes: "Set by T3.2.1. One radius for every unit until a larger creature needs its own.",
        ),
        (
            id: "A-003",
            statement: "Projectile travel speeds, per weapon and spell category, in gwinches per second.",
            value: Table([("flatbow", 1150.0), ("longbow", 1715.0), ("hornbow", 1715.0), ("recurve-bow", 2530.0), ("shortbow", 1715.0), ("spear", 1687.0), ("wand", 1807.0), ("staff", 1807.0), ("spell", 1807.0)]),
            unit: Some(Gwinches),
            rationale: "Derived from the wiki's flight times, each measured over one aggro-circle radius (1012 gwinches): bows 0.88, 0.59, 0.59, 0.40 and 0.59 s (Bow page), spear 0.60 s, wand 0.56 s. The staff is taken to fly like the wand, and projectile spells, which have no published time, are taken to fly like the wand too.",
            status: Assumed,
            sources: ["https://wiki.guildwars.com/wiki/Bow", "https://wiki.guildwars.com/wiki/Spear", "https://wiki.guildwars.com/wiki/Wand"],
            notes: "Set by T3.2.1. Speed modifiers are capped at +100% and -50%.",
        ),
        (
            id: "A-004",
            statement: "A foe's weapon damage and attack interval, where its page does not say.",
            value: Pending,
            rationale: "Creature pages record skills and armor but almost never weapons.",
            status: Assumed,
            notes: "Set by T4.2.1. The fallback is the player weapon table at the foe's level.",
        ),
        (
            id: "A-005",
            statement: "A foe's hard-mode attribute ranks, where the wiki gives none, are its normal-mode ranks plus five, capped at twenty.",
            value: Table([("bonus", 5.0), ("cap", 20.0)]),
            unit: Some(Levels),
            rationale: "The wiki publishes hard-mode ranks for very few foes. The Kournan Seer and Oppressor both gain five; the Bowman gains two, so five is the upper end of what was observed.",
            status: Assumed,
            sources: [
                "https://wiki.guildwars.com/wiki/Kournan_Seer",
                "https://wiki.guildwars.com/wiki/Kournan_Oppressor",
            ],
            notes: "Used by core/modes.ron and by derived::foe_attributes, which tells its caller when it applied.",
        ),
        (
            id: "A-006",
            statement: "The Kournan patrol is one of each of the eight foe types.",
            value: Text("one of each of the eight types"),
            rationale: "No composition is published for the Vehtendi Valley patrol.",
            status: Assumed,
            notes: "Revisited in WP4.8 when the encounter is authored in full.",
        ),
        (
            id: "A-007",
            statement: "A Kournan Guard carries an axe rather than a hammer.",
            value: Text("axe"),
            rationale: "The wiki lists both variants without saying which appears in this patrol.",
            status: Assumed,
            sources: ["https://wiki.guildwars.com/wiki/Kournan_Guard"],
            notes: "Modelled as a foe variant, so the hammer form can be selected instead.",
        ),
        (
            id: "A-008",
            statement: "Foes start about 1800 gwinches ahead of the party, and the party walks in until aggro.",
            value: Gwinches(1800.0),
            unit: Some(Gwinches),
            rationale: "No starting positions are published for any encounter.",
            status: Assumed,
            notes: "Set properly by WP4.8. Clear time counts from aggro, not from this distance.",
        ),
        (
            id: "A-009",
            statement: "The radius at which a foe notices the party.",
            value: Gwinches(1012.0),
            unit: Some(Gwinches),
            rationale: "The Range and Aggro pages equate the aggro bubble with the compass's Danger Zone circle, whose radius is earshot, 1012 gwinches. The wiki notes a few foes see further; none is in M1.",
            status: Assumed,
            sources: ["https://wiki.guildwars.com/wiki/Aggro", "https://wiki.guildwars.com/wiki/Range"],
            notes: "Set by T3.2.1. A group aggroes as one.",
        ),
        (
            id: "A-010",
            statement: "How long a foe takes to react, in normal and in hard mode.",
            value: Pending,
            unit: Some(Milliseconds),
            rationale: "Not documented. The Hard mode page says the AI reacts faster without saying how much.",
            status: Assumed,
            notes: "Set by T4.4.1.",
        ),
        (
            id: "A-011",
            statement: "How long a hero takes to react.",
            value: Pending,
            unit: Some(Milliseconds),
            rationale: "Partly documented: heroes interrupt without delay, which is why they are good at it, but other decisions are not described.",
            status: Assumed,
            notes: "Set by T4.5.1. Interrupts are 0; other decisions take a small default.",
        ),
        (
            id: "A-012",
            statement: "How long the simulated human takes to react to a plan step.",
            value: Millis(250),
            unit: Some(Milliseconds),
            rationale: "Not a game fact at all: it is a modelling choice about how well a person executes a plan. A quarter second is a reasonable human reaction.",
            status: Assumed,
            notes: "Configurable per run. A-029 says the plan is otherwise executed exactly.",
        ),
        (
            id: "A-013",
            statement: "A hero's identity does not affect a simulation beyond its profession and whether the account has it.",
            value: Text("identity affects only profession and availability"),
            rationale: "A simplification, recorded as D17. Heroes differ in appearance and story, not in mechanics.",
            status: Assumed,
        ),
        (
            id: "A-014",
            statement: "Where a foe's attacks land on a character, which decides which armor piece applies.",
            value: Text("the wiki's normal and ranged distribution"),
            rationale: "Size classes are not modelled, so one distribution is used for every attacker.",
            status: Assumed,
        ),
        (
            id: "A-015",
            statement: "The health and armor of a created spirit.",
            value: Pending,
            rationale: "The wiki's figures are marked unofficial, and friendly spirit armor is not published at all.",
            status: Assumed,
            notes: "Set by WP4.3. Hostile spirits are documented at 100 armor and 41 energy in hard mode.",
        ),
        (
            id: "A-016",
            statement: "When a foe scatters out of an area-damage-over-time effect, and how fast.",
            value: Pending,
            unit: Some(Milliseconds),
            rationale: "The wiki describes scatter qualitatively and says it is faster in hard mode, without numbers.",
            status: Assumed,
            notes: "Set by T4.4.1.",
        ),
        (
            id: "A-017",
            statement: "Fast Casting shortens signet activation by the same 0.5^(rank/15) it applies to spells.",
            value: Text("0.5 ^ (rank / 15)"),
            rationale: "The Fast Casting page gives this formula; another page says three per cent per rank. The two disagree, and the Fast Casting page is the more specific source.",
            status: Assumed,
            sources: ["https://wiki.guildwars.com/wiki/Fast_Casting"],
        ),
        (
            id: "A-018",
            statement: "Nature rituals reach 3000 gwinches.",
            value: Gwinches(3000.0),
            unit: Some(Gwinches),
            rationale: "The Nature ritual page records the 2026-08-26 update lowering them to 3000. The Range page still says 2512 or 3500 and appears not to have been updated.",
            status: Assumed,
            sources: [
                "https://wiki.guildwars.com/wiki/Nature_ritual",
                "https://wiki.guildwars.com/wiki/Range",
            ],
            notes: "Used by core/ranges.ron. The most likely value here to need rechecking.",
        ),
        (
            id: "A-019",
            statement: "Whether a consumable's effect survives the user's death is taken from the item's own page.",
            value: Text("per the item page, not the Death page"),
            rationale: "The item pages and the Death page disagree. The item pages are more specific.",
            status: Assumed,
            notes: "Recorded per consumable in items/consumables.ron rather than as one rule.",
        ),
        (
            id: "A-020",
            statement: "A title rank's effective attribute rank comes from the individual rank pages, not from the old formula.",
            value: Text("per the individual rank pages"),
            rationale: "The Title skill page's rank times 1.5 formula is flagged as outdated after the 2012-05-17 update.",
            status: Assumed,
            sources: ["https://wiki.guildwars.com/wiki/Asura_rank"],
            notes: "Used by core/titles.ron.",
        ),
        (
            id: "A-021",
            statement: "The extra one-second bleeding adjustment from condition prefixes and inscriptions is not applied.",
            value: Text("not applied"),
            rationale: "The rule appears only on the Bleeding page and on no other condition page, which suggests it is either wrong or unique in a way nothing else records.",
            status: Assumed,
            sources: ["https://wiki.guildwars.com/wiki/Bleeding"],
        ),
        (
            id: "A-022",
            statement: "Damage modifiers apply in the order the wiki lists them.",
            value: Text("the wiki's listed order"),
            rationale: "The wiki says its own list may contain errors, but offers nothing better.",
            status: Assumed,
            notes: "Worth re-testing in WP3.5 against the worked examples.",
        ),
        (
            id: "A-023",
            statement: "Armor penetration floors after multiplying, which may give one less than the game does.",
            value: Text("floor after multiplying"),
            rationale: "The exact rounding is not documented.",
            status: Assumed,
            notes: "Set by T3.5.1 if a worked example settles it.",
        ),
        (
            id: "A-024",
            statement: "The adjacent area of effect is 166 gwinches.",
            value: Gwinches(166.0),
            unit: Some(Gwinches),
            rationale: "The Area of effect page calls adjacent about a sixth of the aggro bubble, which 166 matches; the Adjacent page says a ninth, which it does not. The self-consistent source wins.",
            status: Assumed,
            sources: [
                "https://wiki.guildwars.com/wiki/Area_of_effect",
                "https://wiki.guildwars.com/wiki/Adjacent",
            ],
            notes: "Used by core/ranges.ron.",
        ),
        (
            id: "A-025",
            statement: "Whether a skill uses the 240 area or the 252 nearby area is a per-skill fact, not a rounding.",
            value: Gwinches(240.0),
            unit: Some(Gwinches),
            rationale: "The wiki names about fifteen skills that use 240 where nearby is 252, which is too specific to be a rounding error.",
            status: Assumed,
            sources: ["https://wiki.guildwars.com/wiki/Area_of_effect"],
            notes: "Modelled as a band in core/ranges.ron, and as Aoe::Radius on a skill.",
        ),
        (
            id: "A-026",
            statement: "Where the Hero behavior page and the 2026 update notes disagree, the update notes win.",
            value: Text("update notes take precedence"),
            rationale: "The Hero behavior page carries an outdated marker, and the 2026 updates changed hero AI substantially.",
            status: Assumed,
            notes: "Revisited in T4.5.1.",
        ),
        (
            id: "A-027",
            statement: "The Reforged Mode bug where foes with negative armor gain armor is not modelled.",
            value: Text("not modelled"),
            rationale: "It affects pre-Searing content only, which gwsim does not simulate.",
            status: Assumed,
        ),
        (
            id: "A-028",
            statement: "The party rests twenty seconds between the fights of a chain.",
            value: Millis(20000),
            unit: Some(Seconds),
            rationale: "Not a game fact: it is a modelling choice about how quickly a party moves between fights.",
            status: Assumed,
            notes: "Configurable per chain step. Used where a situation's chain does not say.",
        ),
        (
            id: "A-029",
            statement: "The simulated human executes its plan exactly as written, subject to A-012's delay.",
            value: Text("plan executed exactly, with the A-012 delay"),
            rationale: "A modelling choice. Modelling mistakes would need a model of how people make them.",
            status: Assumed,
        ),
        (
            id: "A-030",
            statement: "A fight that has run for 180 seconds counts as a loss.",
            value: Millis(180000),
            unit: Some(Seconds),
            rationale: "A modelling choice, so that a stalemate ends rather than running forever.",
            status: Assumed,
            notes: "Used where a situation does not set its own timeout.",
        ),
        (
            id: "A-031",
            statement: "The armor bug where a net bonus of 26 or more makes reductions be ignored is modelled as documented.",
            value: Text("modelled as documented"),
            rationale: "The wiki documents it as a bug rather than intended behaviour, but it is what the game does.",
            status: Assumed,
        ),
        (
            id: "A-032",
            statement: "How much shorter a foe's skill recharges are in hard mode.",
            value: Pending,
            unit: Some(Percent),
            rationale: "The Hard mode page says only that recharges are shorter. There is no number on the wiki to read, so this cannot be settled from sources at all.",
            status: Assumed,
            sources: ["https://wiki.guildwars.com/wiki/Hard_mode"],
            notes: "Set by T4.2.1, which must measure it. T1.1.1 was allowed to settle this and could not.",
        ),
        (
            id: "A-033",
            statement: "The player's runes are superior Domination Magic on the headgear, minor Fast Casting, minor Inspiration Magic, superior Vigor and one of Vitae.",
            value: Text("superior Domination Magic (head), minor Fast Casting, minor Inspiration Magic, superior Vigor, Vitae"),
            rationale: "Read from the current PvX build page's equipment list on 2026-09-23. The Wayback snapshot DESIGN 20.1 cites gives effective ranks only, which is why this began as an inference; the live page names the runes.",
            status: Confirmed,
            notes: "Three attribute runes plus Vigor and Vitae fills all five armor slots exactly, so only one Vitae fits. Player maximum health is 465.",
        ),
        (
            id: "A-034",
            statement: "Hero 7's staff health modifiers are not modelled.",
            value: Pending,
            rationale: "PvX names a Hale Spawning Power staff of fortitude. Both the staff head and the wrapping grant health, but gwsim's item data has no health-granting weapon upgrades and the wiki values have not been read, so encoding a number would be inventing one.",
            status: Assumed,
            sources: ["https://wiki.guildwars.com/wiki/Staff"],
            notes: "Hero 7's reported maximum health of 400 is therefore a floor. Settled by WP4.3, which adds weapon upgrade effects.",
        ),

        // ------------------------------------------------------------------
        // Added by P3 (the engine core), 2026-09-23. Each was a question the
        // engine had to answer that the wiki does not.
        (
            id: "A-035",
            statement: "An auto-attack's hit lands half-way through its attack interval.",
            value: Percent(50.0),
            unit: Some(Percent),
            rationale: "The wiki documents where in the interval an attack skill without an activation time lands (the first half of the next interval) but not an ordinary attack. Using the same half-way point keeps attacks and attack skills on one timeline.",
            status: Assumed,
            sources: ["https://wiki.guildwars.com/wiki/Activation_time", "https://wiki.guildwars.com/wiki/Attack_speed"],
            notes: "T3.1.1. Moves when an attack lands, never how often.",
        ),
        (
            id: "A-036",
            statement: "A party member earns experience from any kill of an experience-giving foe by the party while it is alive and within party range of the kill.",
            value: Gwinches(5020.0),
            unit: Some(Gwinches),
            rationale: "Air of Superiority triggers when the user earns experience from a kill. In the game, kill experience goes to every party member near the kill, not only the killer, but the wiki gives no radius. Party range (5020, the compass) is used.",
            status: Assumed,
            sources: ["https://wiki.guildwars.com/wiki/Air_of_Superiority", "https://wiki.guildwars.com/wiki/Experience"],
            notes: "T3.10.1. Decides how often Air of Superiority fires.",
        ),
        (
            id: "A-037",
            statement: "A caster weapon's damage type follows the wielder's primary profession: Mesmer chaos, Necromancer dark, Monk holy, Ritualist lightning, Elementalist fire; others chaos.",
            value: Text("Mesmer chaos, Necromancer dark, Monk holy, Ritualist lightning, Elementalist fire, others chaos"),
            rationale: "A wand's or staff's damage type depends on the attribute the item is linked to, and gwsim's builds do not record that link. The profession's most common linked attribute is used.",
            status: Assumed,
            sources: ["https://wiki.guildwars.com/wiki/Wand", "https://wiki.guildwars.com/wiki/Staff"],
            notes: "T3.4.10. Only matters against armor that differs by damage type.",
        ),
        (
            id: "A-038",
            statement: "Weapon chance mods of the same kind do not stack: a spell gets one roll at the highest half-cast chance and one at the highest half-recharge chance among the wielder's items.",
            value: Text("one roll per kind, at the highest chance"),
            rationale: "The wiki says the chance is per use and caps the effect, but not how two items with the same mod combine. Not stacking matches how identical upgrades behave elsewhere in the game.",
            status: Assumed,
            sources: ["https://wiki.guildwars.com/wiki/HSR", "https://wiki.guildwars.com/wiki/List_of_weapon_upgrades"],
            notes: "T3.4.1.",
        ),
        (
            id: "A-039",
            statement: "Armor-respecting skill damage picks the struck armor piece with the same distribution as a normal attack.",
            value: Text("the normal and ranged hit-location column"),
            rationale: "The hit-location table is documented for attacks. Spells that respect armor must use some piece, and the wiki does not say which; the attack distribution is the least surprising choice.",
            status: Assumed,
            sources: ["https://wiki.guildwars.com/wiki/Damage_calculation"],
            notes: "T3.5.1. Only matters when armor differs by piece.",
        ),
        (
            id: "A-040",
            statement: "A single-target skill whose target dies or becomes invalid during activation fails: its cost is lost and it recharges instantly.",
            value: Text("fail, not fizzle"),
            rationale: "The wiki's Fail page lists a target dying during activation as a failure (instant recharge), while its Fizzle page lists the same event as a fizzle (no recharge). The Fail page is the more specific of the two.",
            status: Assumed,
            sources: ["https://wiki.guildwars.com/wiki/Fail", "https://wiki.guildwars.com/wiki/Fizzle"],
            notes: "T3.4.1.",
        ),
        (
            id: "A-041",
            statement: "A trigger on the next spell a foe casts fires when the foe starts casting it.",
            value: Text("at the start of activation"),
            rationale: "Mistrust's page says its effect triggers the next time the target tries to cast an enemy-targeting spell, and only otherwise at the end of an activation already under way. The engine applies the common case.",
            status: Assumed,
            sources: ["https://wiki.guildwars.com/wiki/Mistrust"],
            notes: "T3.10.1. A spell already being cast when the hex lands is not caught.",
        ),
    ],
)

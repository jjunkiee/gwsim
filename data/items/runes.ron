// Runes.
//
// Two rules make runes awkward, and both are encoded rather than left to the
// reader:
//
//   * only the HIGHEST rune for an attribute counts, which non_stacking_key
//     decides;
//   * EVERY rune's health penalty applies, stacking or not, even when its
//     bonus is suppressed by a better rune for the same attribute.
//
// The second rule is what makes 55-health farming builds possible, so it is
// not an edge case. Vitae stacks with everything, including itself; Vigor
// does not stack even with itself.
//
// Only the attributes M1 uses are listed. Other professions arrive in P7.
(
    provenance: (
        sources: [
            "https://wiki.guildwars.com/wiki/Rune",
            "https://wiki.guildwars.com/wiki/Rune_of_Vigor",
            "https://wiki.guildwars.com/wiki/Rune_of_Vitae",
            "https://wiki.guildwars.com/wiki/Rune_of_Attunement",
            "https://wiki.guildwars.com/wiki/Equipment_template_format",
        ],
        crawled: "2026-09-22",
        review: Draft,
        reviewed_by: None,
        assumptions: [],
        notes: "Values from T1.4.1. Template modifier ids from T1.3.1, read off the Equipment template format page. Attribute runes only fit the primary profession's armor, so a secondary-profession attribute can never exceed rank 12.",
    ),

    runes: [
        // Fast Casting
        (slug: "minor-fast-casting", name: "Minor Rune of Fast Casting", kind: Attribute(attribute: FastCasting, tier: Minor), bonus: Some(AttributeRank(1)), health_penalty: 0, non_stacking_key: "attribute:FastCasting", template_modifier_id: Some(22)),
        (slug: "major-fast-casting", name: "Major Rune of Fast Casting", kind: Attribute(attribute: FastCasting, tier: Major), bonus: Some(AttributeRank(2)), health_penalty: 35, non_stacking_key: "attribute:FastCasting", template_modifier_id: Some(48)),
        (slug: "superior-fast-casting", name: "Superior Rune of Fast Casting", kind: Attribute(attribute: FastCasting, tier: Superior), bonus: Some(AttributeRank(3)), health_penalty: 75, non_stacking_key: "attribute:FastCasting", template_modifier_id: Some(74)),

        // Domination Magic
        (slug: "minor-domination-magic", name: "Minor Rune of Domination Magic", kind: Attribute(attribute: DominationMagic, tier: Minor), bonus: Some(AttributeRank(1)), health_penalty: 0, non_stacking_key: "attribute:DominationMagic", template_modifier_id: Some(23)),
        (slug: "major-domination-magic", name: "Major Rune of Domination Magic", kind: Attribute(attribute: DominationMagic, tier: Major), bonus: Some(AttributeRank(2)), health_penalty: 35, non_stacking_key: "attribute:DominationMagic", template_modifier_id: Some(49)),
        (slug: "superior-domination-magic", name: "Superior Rune of Domination Magic", kind: Attribute(attribute: DominationMagic, tier: Superior), bonus: Some(AttributeRank(3)), health_penalty: 75, non_stacking_key: "attribute:DominationMagic", template_modifier_id: Some(75)),

        // Illusion Magic (the Solo Resto Ineptitude hero, T5.10.3)
        (slug: "minor-illusion-magic", name: "Minor Rune of Illusion Magic", kind: Attribute(attribute: IllusionMagic, tier: Minor), bonus: Some(AttributeRank(1)), health_penalty: 0, non_stacking_key: "attribute:IllusionMagic", template_modifier_id: Some(24)),
        (slug: "major-illusion-magic", name: "Major Rune of Illusion Magic", kind: Attribute(attribute: IllusionMagic, tier: Major), bonus: Some(AttributeRank(2)), health_penalty: 35, non_stacking_key: "attribute:IllusionMagic", template_modifier_id: Some(50)),
        (slug: "superior-illusion-magic", name: "Superior Rune of Illusion Magic", kind: Attribute(attribute: IllusionMagic, tier: Superior), bonus: Some(AttributeRank(3)), health_penalty: 75, non_stacking_key: "attribute:IllusionMagic", template_modifier_id: Some(76)),

        // Inspiration Magic
        (slug: "minor-inspiration-magic", name: "Minor Rune of Inspiration Magic", kind: Attribute(attribute: InspirationMagic, tier: Minor), bonus: Some(AttributeRank(1)), health_penalty: 0, non_stacking_key: "attribute:InspirationMagic", template_modifier_id: Some(25)),
        (slug: "major-inspiration-magic", name: "Major Rune of Inspiration Magic", kind: Attribute(attribute: InspirationMagic, tier: Major), bonus: Some(AttributeRank(2)), health_penalty: 35, non_stacking_key: "attribute:InspirationMagic", template_modifier_id: Some(51)),
        (slug: "superior-inspiration-magic", name: "Superior Rune of Inspiration Magic", kind: Attribute(attribute: InspirationMagic, tier: Superior), bonus: Some(AttributeRank(3)), health_penalty: 75, non_stacking_key: "attribute:InspirationMagic", template_modifier_id: Some(77)),

        // Blood Magic
        (slug: "minor-blood-magic", name: "Minor Rune of Blood Magic", kind: Attribute(attribute: BloodMagic, tier: Minor), bonus: Some(AttributeRank(1)), health_penalty: 0, non_stacking_key: "attribute:BloodMagic", template_modifier_id: Some(26)),
        (slug: "major-blood-magic", name: "Major Rune of Blood Magic", kind: Attribute(attribute: BloodMagic, tier: Major), bonus: Some(AttributeRank(2)), health_penalty: 35, non_stacking_key: "attribute:BloodMagic", template_modifier_id: Some(52)),
        (slug: "superior-blood-magic", name: "Superior Rune of Blood Magic", kind: Attribute(attribute: BloodMagic, tier: Superior), bonus: Some(AttributeRank(3)), health_penalty: 75, non_stacking_key: "attribute:BloodMagic", template_modifier_id: Some(78)),


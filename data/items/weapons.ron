// Weapon types.
//
// Damage and attack interval are the maximum figures, which apply once the
// wielder meets the weapon's attribute requirement. Two identical weapons
// with different requirements deal the same damage once both are met.
//
// Caster weapons work differently from martial ones, and the difference
// decides which attribute matters:
//
//   * a STAFF's attribute is tied to its DAMAGE, so its +10 energy works for
//     any profession;
//   * a FOCUS's attribute is tied to its ENERGY, so the +12 drops to +6 or +3
//     when the requirement is not met;
//   * wand and staff damage scales with character LEVEL, not with any weapon
//     mastery.
//
// `mastery` is therefore left unset for staves, wands and foci: the linked
// attribute varies per item rather than per type.
(
    provenance: (
        sources: [
            "https://wiki.guildwars.com/wiki/Weapon",
            "https://wiki.guildwars.com/wiki/Bow",
            "https://wiki.guildwars.com/wiki/Energy",
        ],
        crawled: "2026-09-22",
        review: Draft,
        reviewed_by: None,
        assumptions: ["A-003"],
        notes: "Values from T1.4.1. A-003: projectile speeds are not documented per item, so projectile_speed is left unset and the engine uses a per-category default. Ranges are in gwinches, converted from the wiki's aggro-circle multiples using earshot = 1012.",
    ),

    weapons: [
        // Caster weapons. M1's party uses staff, wand and focus only.
        (
            slug: "staff",
            name: "Staff",
            damage_type: None,
            damage_range_at_max_req: Some((11, 22)),
            attack_interval: Some(1.75),
            range: Some(1248.0),
            mastery: None,
            two_handed: true,
            energy: Some(10),
        ),
        (

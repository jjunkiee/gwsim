            range: Some(1248.0),
            mastery: None,
            two_handed: false,
            energy: None,
        ),
        (
            // +12 only when the requirement is met; +6 or +3 otherwise,
            // depending on where the item came from. The reduced values are
            // not modelled, because gwsim only builds sets that meet their
            // own requirements.
            slug: "focus",
            name: "Focus item",
            damage_type: None,
            damage_range_at_max_req: None,
            attack_interval: None,
            range: None,
            mastery: None,
            two_handed: false,
            energy: Some(12),
        ),


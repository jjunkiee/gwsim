        assumptions: ["A-043"],
        notes: "Minions are undead and not fleshy. Degeneration starts at -1 pip and worsens by one pip every 20 seconds. A Bone Fiend attacks every 1.86 seconds with a ranged piercing attack at half longbow range; its damage (A-043) is a longbow's at the minion's level.",
    ),
    minions: [
        (
            slug: "bone-fiend",
            name: "Bone Fiend",
            level: (1, 17),
            weapon: Some((weapon_type: "longbow", damage: Some((15, 28)), attack_interval: Some(1.86))),
            degeneration: Some(-1),
            traits: [Undead],
            armor_per_level: Some((2.84, 3.1)),
            range: Some(749.0),
        ),
    ],

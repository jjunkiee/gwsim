    provenance: (
        sources: ["https://wiki.guildwars.com/wiki/Spirit", "https://wiki.guildwars.com/wiki/Spirit_range", "https://wiki.guildwars.com/wiki/Signet_of_Spirits"],
        crawled: "2026-09-23",
        review: Draft,
        assumptions: ["A-015", "A-018"],
        notes: "Binding rituals reach spirit range (2,512); nature rituals 3,000 since the 2026-08-26 update (A-018). Spirits have 31 energy and 4 pips (41 for hostile spirits in hard mode). Attack spirits attack every 2 seconds at longbow range for armor-ignoring damage.",
    ),
    spirits: [
        (slug: "shelter", name: "Shelter", range: Some(2512.0)),
